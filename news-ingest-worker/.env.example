# Next.js API Connection (phải khớp Next.js ADMIN_API_KEY và NEWS_WORKER_INTERNAL_KEY)
NEXTJS_API_BASE_URL=http://127.0.0.1:3334
ADMIN_API_KEY=your_secret_admin_key
INTERNAL_API_KEY=your_news_worker_internal_key

# AI Providers (không dùng agent, không dùng tool)
GEMINI_API_KEY=your_google_gemini_api_key
# Danh sách key dự phòng xoay vòng khi 429 (phân tách dấu phẩy)
GEMINI_API_KEYS=
GROQ_API_KEY=your_groq_api_key
GROQ_API_KEYS=

# Models
LLM_MODEL=gemini-flash-latest
VISION_MODEL=gemini-flash-latest
WHISPER_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-120b

# Worker tuning
POLL_INTERVAL_SECONDS=10
WORKER_CONCURRENCY=2
MAX_VIDEO_DURATION_SECONDS=1200
MAX_VISION_FRAMES=6
MIN_DESCRIPTION_CHARS=300
MIN_TRANSCRIPT_WORDS=40
# Optional HTTP/SOCKS proxy for yt-dlp media downloads only (not LLM/API calls)
MEDIA_PROXY_URL=
# Optional Cobalt-compatible JSON resolver endpoint for TikTok when yt-dlp hits IP block
TIKTOK_FALLBACK_API_URL=
TIKTOK_FALLBACK_API_KEY=
