// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Tag {
  id        String     @id @default(uuid(7))
  name      String     @unique
  color     String     @default("#6b9ac4")
  prompt    String?    // custom AI prompt for this tag
  createdAt DateTime   @default(now())
  notes     Note[]
  // Note: Favorite model doesn't have foreign key to Tag (tags are from Notion API)
}

model Note {
  id          String   @id @default(uuid(7))
  title       String
  link        String?
  description String?
  tagId       String?
  tag         Tag?     @relation(fields: [tagId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Role {
  id          String          @id @default(uuid(7))
  name        String          @unique
  summary     String
  focusTasks  String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  roleApiRefs RoleApiAccess[]
}

model ApiEndpoint {
  id          String          @id @default(uuid(7))
  method      String
  path        String
  module      String
  summary     String
  requestExample  String?
  responseExample String?
  featureId   String?
  sortOrder   Int             @default(0)
  reviewed    Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  feature     Feature?        @relation(fields: [featureId], references: [id], onDelete: SetNull)
  roleApiRefs RoleApiAccess[]

  @@unique([method, path])
}

model Feature {
  id        String        @id @default(uuid(7))
  name      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  apis      ApiEndpoint[]
}

model RoleApiAccess {
  id        String      @id @default(uuid(7))
  roleId    String
  apiId     String
  access    String      @default("denied")
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  role Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  api  ApiEndpoint @relation(fields: [apiId], references: [id], onDelete: Cascade)

  @@unique([roleId, apiId])
}

// Favorites model - scalable for multi-user
// Note: tagId references tags from Notion API, not the Tag table
model Favorite {
  id        String   @id @default(uuid(7))
  userId    String   // User identifier (can be session ID, email, or user ID from auth)
  tagId     String   // Tag ID from Notion API (no foreign key constraint)
  createdAt DateTime @default(now())

  @@unique([userId, tagId]) // One user can only favorite a tag once
  @@index([userId]) // Fast lookup by user
  @@index([tagId]) // Fast lookup by tag
}

// ─────────────────────────────────────────────────────────────────────────────
// Roadmap Models (Multi-roadmap architecture: AI, Backend, Frontend, etc.)
// ─────────────────────────────────────────────────────────────────────────────

model Roadmap {
  id          String         @id @default(uuid(7))
  slug        String         @unique // e.g. "ai-architecture", "backend-roadmap"
  title       String         // e.g. "AI & LLM Architecture"
  shortCode   String?        @default("AI") // e.g. "AI", "BE", "FE", "DEV"
  description String?
  icon        String?        @default("Layers")
  order       Int            @default(0)
  isLocked    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  layers      RoadmapLayer[]
}

model RoadmapLayer {
  id         String         @id @default(uuid(7))
  roadmapId  String
  roadmap    Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  order      Int            @default(0)
  shortTag   String         // e.g. "01-DB", "02-LLM"
  title      String
  subtitle   String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  groups     RoadmapGroup[]

  @@index([roadmapId])
}

model RoadmapGroup {
  id        String        @id @default(uuid(7))
  layerId   String
  layer     RoadmapLayer  @relation(fields: [layerId], references: [id], onDelete: Cascade)
  level     String        // "core" | "intermediate" | "advanced" | custom
  title     String
  order     Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  items     RoadmapItem[]

  @@index([layerId])
}

model RoadmapItem {
  id          String       @id @default(uuid(7))
  groupId     String
  group       RoadmapGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String?
  content     String?      // Rich-text HTML content from Lexical editor
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([groupId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Workflow Builder (docs/workflow-builder-design.md)
// Owner-only for now; projectId + ownerId (owner email) keep multi-user open.
// SQLite on Prisma 5 has no enums or Json: statuses are strings, graphs are JSON text.
// ─────────────────────────────────────────────────────────────────────────────

model WorkflowProject {
  id          String   @id @default(uuid(7))
  ownerId     String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents ProjectDocument[]
  chunks    ProjectChunk[]
  workflows Workflow[]
  runs      WorkflowRun[]

  @@index([ownerId])
}

model ProjectDocument {
  id          String          @id @default(uuid(7))
  projectId   String
  project     WorkflowProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId     String
  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String          @unique // workflow-kb/{projectId}/{documentId}
  contentHash String // sha256 of the raw file; unchanged re-upload skips embedding
  status      String          @default("PENDING") // PENDING | READY | FAILED
  error       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  chunks ProjectChunk[]

  @@index([projectId])
  @@index([projectId, contentHash])
}

model ProjectChunk {
  id             String          @id @default(uuid(7))
  // Denormalized so every retrieval query filters by project
  projectId      String
  project        WorkflowProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId     String
  document       ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal        Int
  heading        String?
  content        String
  contentHash    String // sha256 of content; reuse the embedding when unchanged
  embedding      Bytes? // Float32Array, 768 dims
  embeddingModel String?
  createdAt      DateTime        @default(now())

  @@index([projectId])
  @@index([documentId])
  @@index([projectId, contentHash])
}

model Workflow {
  id             String          @id @default(uuid(7))
  projectId      String
  project        WorkflowProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId        String
  name           String
  description    String?
  draftGraph     String // JSON: WorkflowGraph (runtime semantics)
  draftUi        String // JSON: WorkflowUi (positions, labels, viewport)
  draftGraphHash String // sha256(canonical(draftGraph)); UI-only edits keep it
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  versions WorkflowVersion[]
  runs     WorkflowRun[]

  @@index([projectId])
}

// Immutable once published
model WorkflowVersion {
  id            String   @id @default(uuid(7))
  workflowId    String
  workflow      Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  versionNumber Int
  graph         String // JSON: WorkflowGraph
  graphHash     String
  ui            String // JSON: WorkflowUi
  createdAt     DateTime @default(now())

  runs WorkflowRun[]

  @@unique([workflowId, versionNumber])
}

model WorkflowRun {
  id                String           @id @default(uuid(7))
  projectId         String
  project           WorkflowProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerId           String
  workflowId        String
  workflow          Workflow         @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  // Set when running a published version; otherwise the draft is snapshotted below
  workflowVersionId String?
  workflowVersion   WorkflowVersion? @relation(fields: [workflowVersionId], references: [id])
  graphSnapshot     String? // JSON: draft graph at run time
  graphHash         String
  status            String           @default("PENDING") // PENDING | RUNNING | SUCCEEDED | FAILED | CANCELLED
  trigger           String // MANUAL | API
  dryRun            Boolean          @default(false)
  input             String // JSON
  output            String? // JSON
  error             String?
  traceId           String? // Langfuse trace id
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime         @default(now())

  nodeExecutions NodeExecution[]

  @@index([workflowId, createdAt])
  @@index([projectId])
}

model NodeExecution {
  id           String      @id @default(uuid(7))
  runId        String
  run          WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId       String // id inside the graph
  nodeType     String
  status       String      @default("PENDING") // PENDING | RUNNING | SUCCEEDED | SKIPPED | FAILED | CANCELLED
  input        String? // JSON
  output       String? // JSON
  error        String?
  model        String?
  inputTokens  Int?
  outputTokens Int?
  startedAt    DateTime?
  finishedAt   DateTime?
  durationMs   Int?

  @@unique([runId, nodeId])
}

// Gemini free-tier quota is per Google project + model, shared by every workflow
model WorkflowQuotaUsage {
  id        String   @id @default(uuid(7))
  day       String // UTC date, YYYY-MM-DD
  model     String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([day, model])
}

// Missing Knowledge Triage for Real-Time Learning & LLM Observability
model KnowledgeTriage {
  id           String   @id @default(uuid(7))
  traceId      String?
  query        String
  assistantMsg String?
  reason       String?  // e.g. "Ảo giác / Sai kiến thức"
  comment      String?  // Detail feedback from user
  status       String   @default("PENDING") // PENDING | DRAFTED | APPROVED | DISMISSED
  roadmapSlug  String?  // Target topic/roadmap slug
  layerId      String?  // Target layer id
  layerTag     String?  // Target layer short tag e.g. "02-LLM"
  level        String?  @default("core") // core | intermediate | advanced
  draftTitle   String?
  draftContent String?  // Rich text or markdown content
  verifyScore  Int?     // 0 - 100
  verifyNote   String?  // Agent Admin verification review note
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

