// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Roadmap Models (Multi-roadmap architecture: AI, Backend, Frontend, etc.)
// ─────────────────────────────────────────────────────────────────────────────

model Roadmap {
  id          String         @id @default(uuid(7))
  slug        String         @unique // e.g. "ai-architecture", "backend-roadmap"
  title       String         // e.g. "AI & LLM Architecture"
  description String?
  icon        String?        @default("Layers")
  order       Int            @default(0)
  isLocked    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items       RoadmapItem[]
}

model RoadmapItem {
  id          String       @id @default(uuid(7))
  roadmapId   String
  roadmap     Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  section     String?      // Optional mục of the topic (ADR-0009); null = chung
  title       String
  description String?
  content     String?      // Rich-text HTML content from Lexical editor
  order       Int          @default(0)
  // Lesson Status (ADR-0010): target | learning | known. The Owner's progress, shown to the Owner only
  status          String    @default("known")
  statusUpdatedAt DateTime? // When the status last changed; null = never changed since it was created
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([roadmapId, title])
  @@index([roadmapId])
}

// Missing Knowledge Triage for Real-Time Learning & LLM Observability
model KnowledgeTriage {
  id           String   @id @default(uuid(7))
  traceId      String?
  query        String
  assistantMsg String?
  reason       String?  // e.g. "Ảo giác / Sai kiến thức"
  comment      String?  // Detail feedback from user
  status       String   @default("PENDING") // PENDING | DRAFTED | APPROVED | DISMISSED
  roadmapSlug  String?  // Target topic/roadmap slug
  section      String?  // Target mục of the topic (ADR-0009); null = chung
  draftTitle   String?
  draftContent String?  // Rich text or markdown content
  verifyScore  Int?     // 0 - 100
  verifyNote   String?  // Agent Admin verification review note
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
