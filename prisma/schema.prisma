// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Roadmap Models (Multi-roadmap architecture: AI, Backend, Frontend, etc.)
// ─────────────────────────────────────────────────────────────────────────────

model Roadmap {
  id          String         @id @default(uuid(7))
  slug        String         @unique // e.g. "ai-architecture", "backend-roadmap"
  title       String         // e.g. "AI & LLM Architecture"
  description String?
  icon        String?        @default("Layers")
  order       Int            @default(0)
  isLocked    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items       RoadmapItem[]
}

model RoadmapItem {
  id          String       @id @default(uuid(7))
  roadmapId   String
  roadmap     Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  slug        String       @unique
  section     String?      // Optional mục of the topic (ADR-0009); null = chung
  title       String
  description String?
  content     String?      // Rich-text HTML content from Lexical editor
  order       Int          @default(0)
  // Lesson Status (ADR-0010): target | learning | known. The Owner's progress, shown to the Owner only
  status          String    @default("known")
  statusUpdatedAt DateTime? // When the status last changed; null = never changed since it was created
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([roadmapId, title])
  @@index([roadmapId])
}

model SlugRedirect {
  fromSlug  String   @id
  entity    String
  targetId  String
  createdAt DateTime @default(now())

  @@index([entity, targetId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Thread state of the Owner (ADR-0012): history and open Topic of a Roadmap Assistant Thread
// ─────────────────────────────────────────────────────────────────────────────

model ThreadMessage {
  id        Int      @id @default(autoincrement()) // Strictly increasing, so it orders a Thread's messages
  threadId  String   // Always "owner:..."; a Visitor's Thread is never stored
  role      String   // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([threadId])
  @@index([createdAt])
}

model ThreadState {
  threadId          String    @id
  activeTopicSlug   String?
  activeTopicTitle  String?
  activeLessonId    String?
  activeLessonTitle String?
  activeSection     String?
  closedAt          DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([updatedAt])
  @@index([closedAt, updatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Owner Memory across Threads (ADR-0015): profile, techstack, goals, preferences, notes
// Strictly Owner-only; never loaded or exposed for Visitors.
// ─────────────────────────────────────────────────────────────────────────────

model OwnerMemory {
  id               String    @id @default(uuid(7))
  kind             String    // profile | techstack | goal | preference | learning_note
  scopeTopicSlug   String?   // null = global; topic slug = injected when working on that Topic
  content          String    // Short atomic fact (<= 300 chars)
  source           String    @default("explicit") // explicit | suggested
  status           String    @default("active")   // active | pending | archived
  replacesMemoryId String?   // Optional active memory archived when a pending item is approved
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastUsedAt       DateTime?

  @@index([status, scopeTopicSlug])
  @@index([kind, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Private News Reader Models (/news, /share, /api/ingest)
// ─────────────────────────────────────────────────────────────────────────────

model NewsSource {
  id            String     @id @default(uuid(7))
  name          String
  feedUrl       String     @unique
  domain        String
  enabled       Boolean    @default(true)
  defaultTags   String     @default("[]")
  etag          String?
  lastModified  String?
  lastFetchedAt DateTime?
  lastError     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  items         NewsItem[]
}

model NewsItem {
  id                    String      @id @default(uuid(7))
  sourceUrl             String
  canonicalUrl          String      @unique
  domain                String
  platform              String      // "youtube" | "tiktok" | "article" | "rss"
  origin                String      // "cron" | "share" | "manual"

  sourceId              String?
  source                NewsSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  title                 String
  author                String?
  thumbnailUrl          String?
  tldr                  String?
  takeaways             String      @default("[]")
  tags                  String      @default("[]")
  personalNote          String?

  ingestStatus          String      @default("queued")    // "queued" | "processing" | "ready" | "partial" | "failed"
  reviewStatus          String      @default("published") // "draft" | "published" | "dismissed"
  readState             String      @default("unread")    // "unread" | "read"
  isSaved               Boolean     @default(false)

  extractionMethod      String?     // "description" | "article" | "captions" | "whisper" | "vision" | "metadata_only"
  extractionError       String?
  normalizedTitle       String?
  possibleDuplicateOfId String?
  publishedAt           DateTime?

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  jobs                  IngestJob[]

  @@index([reviewStatus, readState, createdAt])
  @@index([isSaved, reviewStatus, createdAt])
  @@index([isSaved, createdAt])
  @@index([origin, createdAt])
  @@index([createdAt])
  @@index([ingestStatus])
  @@index([normalizedTitle])
}

model IngestJob {
  id          String    @id @default(uuid(7))
  newsItemId  String
  newsItem    NewsItem  @relation(fields: [newsItemId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // "pending" | "running" | "done" | "failed"
  stage       String?
  forceDeep   Boolean   @default(false)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  nextRunAt   DateTime  @default(now())
  lockedUntil DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextRunAt])
  @@index([status, lockedUntil])
  @@index([newsItemId])
}

