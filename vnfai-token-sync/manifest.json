{
  "manifest_version": 3,
  "name": "VNFai Token Sync",
  "version": "1.0.0",
  "description": "Tự động sync Bearer token từ upb.ops.vnfai.com sang internal tools",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://ops-api.vnfai.com/*",
    "https://upb.ops.vnfai.com/*",
    "http://localhost:*/*",
    "https://*.vercel.app/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:*/*",
      "https://*.vercel.app/*",
      "https://*.vnfai.com/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://upb.ops.vnfai.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VNFai Token Sync"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
