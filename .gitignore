# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma SQLite — keep dev.db in repo, ignore migrations lock
prisma/migrations/migration_lock.toml
# SQLite WAL side files and the test database (tests/setup/test-db.ts)
prisma/dev.db-shm
prisma/dev.db-wal
prisma/test.db*

# Auto-generated agent rules (personalized per developer)
.brainsync/agent-rules.md

AGENT.md
CLAUDE.md
.agent-mem/
.gitnexus

# Uploaded images
/public/uploads/

# Favorites data (user-specific)
/data/favorites.json

# Roadmap RAG: cached embedding vectors (regenerated on demand)
roadmap-rag-assistant/rag_service/data/embedding_cache.json

# Local dev launch config
.claude/

# Workflow KB local storage
.data/workflow-kb/

# Python bytecode
__pycache__/
*.pyc

# RAG conversation memory (RAG_HISTORY_DB)
roadmap-rag-assistant/data/history.db*
