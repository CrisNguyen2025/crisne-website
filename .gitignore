# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma SQLite — keep dev.db in repo, ignore migrations lock
prisma/migrations/migration_lock.toml
# SQLite WAL side files and the test database (tests/setup/test-db.ts)
prisma/dev.db-shm
prisma/dev.db-wal
prisma/test.db*

# Auto-generated agent rules (personalized per developer)
.brainsync/agent-rules.md

AGENT.md
.agent-mem/
.gitnexus

# Uploaded images
/public/uploads/

# Favorites data (user-specific)
/data/favorites.json

# Roadmap RAG: cached embedding vectors (regenerated on demand)
roadmap-rag-assistant/rag_service/data/embedding_cache.json

# Claude Code: per-machine files (skills symlinks and settings.json are shared)
.claude/launch.json
.claude/settings.local.json
.claude/worktrees/
# Written by `gitnexus analyze`; the shared copy lives in .agents/skills/gitnexus-*
.claude/skills/gitnexus/
# Personal skills, move to the personal agent-config repo in Phase B
.claude/skills/think/
.claude/skills/prompt-master/
.claude/skills/query-optimizer/
CLAUDE.local.md

# Python bytecode
__pycache__/
*.pyc

# RAG conversation memory (RAG_HISTORY_DB)
roadmap-rag-assistant/data/history.db*

# Eval answer cache (roadmap-rag-assistant/evals/target.py)
roadmap-rag-assistant/evals/.cache/

# Backups written by scripts/flatten-to-sections.ts (contain the roadmap as it was)
flatten-backup-*.json

# Runtime logs appended by the RAG service during load tests
tests/load/results/*.log

# Playwright MCP runtime logs and snapshots
.playwright-mcp/

lesson-status-backup-*.json
seed-import-backup-*.json

# Output của /api/backup-notes
docs/backup*.md
docs/backup*.json

roadmap-rag-assistant/sdk/typescript/dist/

