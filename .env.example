# ==============================================================================
# CRISNE WEBSITE - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & RAG CHATBOT (BẮT BUỘC để Chatbot AI hoạt động)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_google_gemini_api_key_here

# Langfuse tracing cho /api/chat (bỏ trống = tắt tracing)
# BASE_URL phải khớp region của project: EU https://cloud.langfuse.com,
# US https://us.cloud.langfuse.com, JP https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# Tách trace dev/production trên dashboard (mặc định theo NODE_ENV: development | production)
# LANGFUSE_TRACING_ENVIRONMENT=staging
# Gắn trace với phiên bản deploy (mặc định dùng VERCEL_GIT_COMMIT_SHA nếu có)
# LANGFUSE_RELEASE=v1.2.0

# URL của Python FastAPI RAG Service
# Local: http://localhost:8000
# Production (Render / Railway / VPS): https://your-rag-service.onrender.com
NEXT_PUBLIC_RAG_SERVICE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. DATABASE (BẮT BUỘC cho Prisma)
# Mặc định local dùng SQLite:
# ------------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# Turso Cloud SQLite (Dành cho Production trên Vercel):
# Lấy từ Turso Dashboard hoặc CLI (`turso db tokens create crisne-db`)
TURSO_DATABASE_URL="libsql://crisne-db-ntienanh.aws-ap-northeast-1.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# ------------------------------------------------------------------------------
# 3. ANALYTICS (Tùy chọn)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-XYFE5H3634
NEXT_PUBLIC_GTM_ID=

# ------------------------------------------------------------------------------
# 4. KNOWLEDGE OS & CLIPPER ADMIN KEY (Tùy chọn)
# ------------------------------------------------------------------------------
ADMIN_API_KEY=your_secret_admin_key

# ------------------------------------------------------------------------------
# 5. NOTION INTEGRATION (Tùy chọn - Dùng khi đồng bộ Notes từ Notion)
# ------------------------------------------------------------------------------
NOTION_TOKEN=
NOTION_POSTS_DB_ID=
NOTION_TAGS_DB_ID=
NOTION_FAVORITES_DB_ID=

# ------------------------------------------------------------------------------
# 6. CLOUDFLARE R2 STORAGE (Tùy chọn - Dùng khi upload ảnh lên R2)
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
