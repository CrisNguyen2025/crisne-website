# ==============================================================================
# CRISNE WEBSITE — ENV TEMPLATE & SYNC GUIDE (Next.js App)
# ==============================================================================
#
# ENV FILE PRECEDENCE (Local):
#   1. .env                       -> Prisma CLI (`prisma db push`, `prisma generate`) ONLY reads `.env`. Keep `DATABASE_URL` here.
#   2. .env.local                 -> PRIMARY local config for Next.js (overrides `.env`) and `scripts/*.ts` (`loadEnvFile`).
#   3. roadmap-rag-assistant/.env -> Config for Abot RAG service (see `roadmap-rag-assistant/.env.example`).
#   4. news-ingest-worker/.env    -> Overrides `.env.local` & `.env` for News worker (see `news-ingest-worker/.env.example`).
#   *  Tests (`vitest.config.mts`) isolate env automatically (`DATABASE_URL=file:./test.db`, mock keys) and ignore `.env.local`.
#   *  Full Production matrix (Vercel / Render): see `docs/DEPLOY_ENV.md`.
#
# TAGS:
#   [REQUIRED]       Required in both Local and Production for core features.
#   [REQUIRED:PROD]  Required in Production; optional or has fallback in Local.
#   [REQUIRED:ABOT]  Required when running Roadmap Assistant (`roadmap-rag-assistant`).
#   [OPTIONAL]       Safe to leave empty (feature disabled or uses default).
#   [LOCAL ONLY]     Only active when `NODE_ENV=development`; NEVER set in Production.
#   [SYNC: target]   Value MUST match the referenced key in another service env file.

# ------------------------------------------------------------------------------
# 1. DATABASE (Prisma SQLite Local & Turso Cloud)
# ------------------------------------------------------------------------------
# [REQUIRED] Local SQLite path for Prisma CLI (set in `.env`) and needed at build time on Vercel (`prisma generate`).
DATABASE_URL="file:./dev.db"

# [REQUIRED:PROD][OPTIONAL:LOCAL] Turso libSQL URL (`libsql://...`). Leave commented in `.env.local` to use local `prisma/dev.db`.
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# [REQUIRED:PROD][OPTIONAL:LOCAL] Turso auth token (`turso db tokens create <db>`). Leave commented in `.env.local` for local SQLite.
# TURSO_AUTH_TOKEN=""

# ------------------------------------------------------------------------------
# 2. AUTH & ACCESS CONTROL
# ------------------------------------------------------------------------------
# [REQUIRED:PROD][OPTIONAL:LOCAL] Auth.js v5 JWT secret. Generate: `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# [REQUIRED:PROD][OPTIONAL:LOCAL] Google OAuth Web Client ID (callbacks: `http://localhost:3334/api/auth/callback/google`, prod domain).
AUTH_GOOGLE_ID=
# [REQUIRED:PROD][OPTIONAL:LOCAL] Google OAuth Web Client Secret.
AUTH_GOOGLE_SECRET=
# [REQUIRED] Comma-separated allowlisted owner emails allowed to sign in and write. Empty = fail-closed (nobody allowed).
AUTH_OWNER_EMAILS=
# [REQUIRED][SYNC: roadmap-rag-assistant/.env -> ADMIN_API_KEY & news-ingest-worker/.env -> ADMIN_API_KEY]
# Shared secret for machine-to-machine requests (`x-admin-key` header) used by scripts and Python services. Empty = fail-closed.
ADMIN_API_KEY=
# [OPTIONAL][LOCAL ONLY] Bypass Google OAuth in `next dev` (`NODE_ENV=development` only). NEVER set in Production.
# DEV_OWNER_BYPASS=true

# ------------------------------------------------------------------------------
# 3. AI & LLM (Cris AI, Embeddings, Knowledge Index)
# ------------------------------------------------------------------------------
# [REQUIRED][SYNC: roadmap-rag-assistant/.env -> GEMINI_API_KEY & news-ingest-worker/.env -> GEMINI_API_KEY]
# Google AI Studio key for Gemini chat, embeddings, and `yarn index:knowledge`.
GEMINI_API_KEY=
# [OPTIONAL] Next.js `/api/chat` generation provider: `gemini` (default) | `groq`. Embeddings always use Gemini.
# LLM_PROVIDER=gemini
# [OPTIONAL][SYNC: roadmap-rag-assistant/.env -> GROQ_API_KEY & news-ingest-worker/.env -> GROQ_API_KEY]
# Required on Next.js only if `LLM_PROVIDER=groq` (single key). Also used by Python services for Groq Whisper / LLM.
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 4. ROADMAP ASSISTANT PROXY (Abot -> roadmap-rag-assistant)
# ------------------------------------------------------------------------------
# [REQUIRED:ABOT][SYNC: counterpart of roadmap-rag-assistant/.env -> NEXTJS_API_BASE_URL]
# Base URL of FastAPI RAG service (no trailing slash). Use `127.0.0.1` locally on macOS to avoid IPv6 localhost mismatch.
RAG_SERVICE_URL=http://127.0.0.1:8000
# [REQUIRED:ABOT][SYNC: roadmap-rag-assistant/.env -> INTERNAL_API_KEY]
# Shared secret sent by `/api/roadmap-assistant/*` proxy (`x-internal-key`). Generate: `openssl rand -base64 32`. Missing = 503.
RAG_INTERNAL_KEY=

# ------------------------------------------------------------------------------
# 5. PRIVATE NEWS READER & WORKER (/news, /share, /api/ingest, news-ingest-worker)
# ------------------------------------------------------------------------------
# [OPTIONAL][SYNC: counterpart of news-ingest-worker/.env -> NEXTJS_API_BASE_URL]
# Base URL of `news-ingest-worker` (no trailing slash). Empty = skip `/internal/wake` ping (worker still polls on interval).
NEWS_WORKER_URL=http://127.0.0.1:8001
# [OPTIONAL][SYNC: news-ingest-worker/.env -> INTERNAL_API_KEY]
# Required if `NEWS_WORKER_URL` is set. Sent via `x-internal-key` to wake the worker. Generate: `openssl rand -hex 32`.
NEWS_WORKER_INTERNAL_KEY=
# [OPTIONAL] Shared secret for `GET`/`POST /api/news/cron` (`Authorization: Bearer <CRON_SECRET>` or `x-cron-secret`). Generate: `openssl rand -hex 32`.
CRON_SECRET=
# [OPTIONAL] Max items ingested per RSS source per cron run when `maxItemsPerSource` is omitted (`1..30`, default `10`).
NEWS_CRON_MAX_ITEMS_PER_SOURCE=10
# [OPTIONAL] Comma-separated extra domains allowed for manual/share ingest beyond `DEFAULT_ALLOWED_DOMAINS` and enabled `NewsSource` domains.
NEWS_ALLOWED_DOMAINS=

# ------------------------------------------------------------------------------
# 6. OBSERVABILITY (Langfuse Tracing & Review Queue)
# ------------------------------------------------------------------------------
# [OPTIONAL][SYNC: roadmap-rag-assistant/.env -> LANGFUSE_PUBLIC_KEY] Leave empty to disable Langfuse tracing.
LANGFUSE_PUBLIC_KEY=
# [OPTIONAL][SYNC: roadmap-rag-assistant/.env -> LANGFUSE_SECRET_KEY]
LANGFUSE_SECRET_KEY=
# [OPTIONAL][SYNC: roadmap-rag-assistant/.env -> LANGFUSE_BASE_URL] Region endpoint: `https://jp.cloud.langfuse.com` (JP), `https://cloud.langfuse.com` (EU), `https://us.cloud.langfuse.com` (US).
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# [OPTIONAL] Tracing environment tag (defaults to `NODE_ENV`: `development` | `production`).
# LANGFUSE_TRACING_ENVIRONMENT=development
# [OPTIONAL] Release tag attached to traces (defaults to `VERCEL_GIT_COMMIT_SHA`).
# LANGFUSE_RELEASE=
# [OPTIONAL] Review queue ID for 👎 feedback generated by `yarn setup:langfuse-review`. Empty = only records score.
LANGFUSE_ANNOTATION_QUEUE_ID=

# ------------------------------------------------------------------------------
# 7. STORAGE (Cloudflare R2 — image uploads)
# ------------------------------------------------------------------------------
# [REQUIRED:PROD][OPTIONAL:LOCAL] Cloudflare Account ID. Missing R2 vars falls back to local `.data/` (ephemeral on Vercel).
R2_ACCOUNT_ID=
# [REQUIRED:PROD][OPTIONAL:LOCAL] R2 S3-compatible Access Key ID.
R2_ACCESS_KEY_ID=
# [REQUIRED:PROD][OPTIONAL:LOCAL] R2 S3-compatible Secret Access Key.
R2_SECRET_ACCESS_KEY=
# [REQUIRED:PROD][OPTIONAL:LOCAL] R2 bucket name.
R2_BUCKET_NAME=
# [OPTIONAL] Public CDN base URL for uploaded assets (defaults to `https://pub-${R2_ACCOUNT_ID}.r2.dev`).
R2_PUBLIC_URL=

# ------------------------------------------------------------------------------
# 8. NOTION INTEGRATION (Notes sync)
# ------------------------------------------------------------------------------
# [OPTIONAL] Notion Internal Integration secret (`secret_...` / `ntn_...`).
NOTION_TOKEN=
# [OPTIONAL] Notion database ID for blog posts.
NOTION_POSTS_DB_ID=
# [OPTIONAL] Notion database ID for tags.
NOTION_TAGS_DB_ID=
# [OPTIONAL] Notion database ID for favorites.
NOTION_FAVORITES_DB_ID=

# ------------------------------------------------------------------------------
# 9. ANALYTICS & PUBLIC LINKS
# ------------------------------------------------------------------------------
# [OPTIONAL] Google Analytics 4 measurement ID (defaults to `G-XYFE5H3634` in `lib/analytics.ts` if unset).
NEXT_PUBLIC_GA_ID=
# [OPTIONAL] Google Tag Manager container ID.
NEXT_PUBLIC_GTM_ID=
# [OPTIONAL] Zalo contact CTA URL (defaults to `https://zalo.me` in `components/cta-section.tsx` if unset).
NEXT_PUBLIC_ZALO_URL=
