{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evals/kit/schema/document.schema.json",
  "title": "Knowledge document",
  "description": "One line of corpus documents.jsonl. doc_id and section_id are assigned once and never change; datasets point at section_id.",
  "version": "1.0.0",
  "type": "object",
  "required": ["doc_id", "title", "doc_type", "acl", "sections"],
  "additionalProperties": false,
  "properties": {
    "doc_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$" },
    "source_id": { "type": ["string", "null"], "description": "Id in the system the document was exported from; used to keep doc_id across exports" },
    "title": { "type": "string", "minLength": 1 },
    "doc_type": { "type": "string", "minLength": 1 },
    "acl": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section_id", "text"],
        "additionalProperties": false,
        "properties": {
          "section_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9/_#-]*$" },
          "heading": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
