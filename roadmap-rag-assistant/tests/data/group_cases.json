  "pick": [
    {"name": "named by id", "groups": ["Core", "Production"], "groupId": "g2", "expect": ["existing", "Production"]},
    {"name": "unknown id asks", "groups": ["Core", "Production"], "groupId": "nope", "expect": ["ask", ["Core", "Production"]]},
    {"name": "named by title, any case and spacing", "groups": ["Core", "Production"], "groupTitle": "  production ", "expect": ["existing", "Production"]},
    {"name": "diacritics count", "groups": ["Cơ bản"], "groupTitle": "Co ban", "expect": ["create", "Co ban"]},
    {"name": "new title is created", "groups": ["Core"], "groupTitle": "Deep  Dive", "expect": ["create", "Deep Dive"]},
    {"name": "the only group", "groups": ["Core"], "expect": ["existing", "Core"]},
    {"name": "several groups ask", "groups": ["Core", "Production"], "expect": ["ask", ["Core", "Production"]]},
    {"name": "no group yet asks", "groups": [], "expect": ["ask", []]},
    {"name": "blank title is no title", "groups": ["Core", "Production"], "groupTitle": "   ", "expect": ["ask", ["Core", "Production"]]}
