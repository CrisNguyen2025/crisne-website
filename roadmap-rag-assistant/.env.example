# LLM Configuration
# LLM_PROVIDER: google_genai | groq   (LLM_MODEL must be a model of that provider)
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-flash-latest
GEMINI_API_KEY=your-gemini-api-key
# Groq (free tier, no card): https://console.groq.com/keys
GROQ_API_KEY=

# Adapter Mode: "http" or "sqlite"
RAG_ADAPTER_MODE=http

# HTTP Adapter (Next.js API)
NEXTJS_API_BASE_URL=http://localhost:3000

# SQLite Adapter (direct DB access)
SQLITE_DB_PATH=../prisma/dev.db

# Langfuse tracing (optional — tracing is off when the keys are empty)
# Same project as the Next.js app (its 👍/👎 scores attach to these traces). BASE_URL must match the
# project's region: EU https://cloud.langfuse.com, US https://us.cloud.langfuse.com, JP https://jp.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
# production on the deployed service, so its traces are filtered apart from local runs
# LANGFUSE_TRACING_ENVIRONMENT=development

# Must match ADMIN_API_KEY in the Next.js app (.env) so the assistant can write data
ADMIN_API_KEY=your_secret_admin_key

# Must match RAG_INTERNAL_KEY in the Next.js app: only its proxy (/api/roadmap-assistant) may call
# this service. Empty = every request except /health gets 401.
INTERNAL_API_KEY=
# Comma-separated browser origins (normally empty: browsers go through the Next.js proxy)
CORS_ORIGINS=

# Conversation memory file. Empty = in RAM (lost on restart).
RAG_HISTORY_DB=data/history.db
# Rewrite "bài đó"-style questions from history before searching (one extra LLM call for those only)
RAG_QUERY_TRANSFORM=true
