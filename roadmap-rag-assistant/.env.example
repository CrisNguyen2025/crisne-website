# LLM Configuration
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.0-flash
LLM_PROVIDER=google_genai

# Adapter Mode: "http" or "sqlite"
RAG_ADAPTER_MODE=http

# HTTP Adapter (Next.js API)
NEXTJS_API_BASE_URL=http://localhost:3000

# SQLite Adapter (direct DB access)
SQLITE_DB_PATH=../prisma/dev.db

# Langfuse tracing (optional — tracing is off when the keys are empty)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=development
